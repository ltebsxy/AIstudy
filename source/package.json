{
  "name": "ai-studydesk",
  "version": "0.1.4",
  "license": "GPL-3.0-only",
  "private": true,
  "description": "本地学习与做题桌面软件",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "smoke": "node tests/smoke.js",
    "dist": "electron-builder --win nsis",
    "smoke:course": "node tests/course-smoke.js",
    "vendor:math": "node scripts/sync-math-assets.js",
    "predist": "npm run vendor:math && npm run vendor:reader",
    "smoke:math": "node tests/math-smoke.js",
    "smoke:workflow": "node tests/workflow-smoke.js",
    "smoke:selection": "node tests/lesson-selection-smoke.js",
    "smoke:chat-capture": "node tests/chat-capture-smoke.js",
    "smoke:settings": "node tests/settings-history-smoke.js",
    "smoke:modes": "node tests/study-modes-smoke.js",
    "smoke:library": "node tests/library-smoke.js",
    "vendor:reader": "node scripts/sync-reader-assets.js",
    "smoke:reader": "node tests/reader-smoke.js",
    "smoke:writer": "node tests/infinite-writer-smoke.js",
    "smoke:writer-layout": "node tests/writer-layout-smoke.js",
    "smoke:loading": "node tests/loading-smoke.js",
    "smoke:startup": "node tests/startup-smoke.js",
    "icon": "electron scripts/make-icon.js"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "^1.63.0"
  },
  "build": {
    "appId": "local.studydesk.app",
    "productName": "AI-StudyDesk",
    "executableName": "AI-StudyDesk",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "lib/**/*",
      "!lib/courses{,/**/*}",
      "package.json",
      "assets/icon.png"
    ],
    "directories": {
      "output": "../app"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "AI-StudyDesk-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraFiles": [
      { "from": "../LICENSE", "to": "LICENSE.txt" },
      { "from": "../THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" },
      { "from": "../README.md", "to": "README.md" }
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ]
  },
  "dependencies": {
    "katex": "0.18.9"
  }
}
