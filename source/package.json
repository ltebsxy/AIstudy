{
  "name": "study-desk",
  "version": "1.0.0",
  "private": true,
  "description": "本地学习与做题桌面软件",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "smoke": "node tests/smoke.js",
    "dist": "electron-builder --win nsis",
    "smoke:course": "node tests/course-smoke.js",
    "vendor:math": "node scripts/sync-math-assets.js",
    "predist": "npm run vendor:math",
    "smoke:math": "node tests/math-smoke.js",
    "smoke:workflow": "node tests/workflow-smoke.js",
    "smoke:selection": "node tests/lesson-selection-smoke.js",
    "smoke:chat-capture": "node tests/chat-capture-smoke.js",
    "smoke:settings": "node tests/settings-history-smoke.js"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.63.0"
  },
  "build": {
    "appId": "local.studydesk.app",
    "productName": "知序学习",
    "executableName": "StudyDesk",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "lib/**/*",
      "package.json"
    ],
    "directories": {
      "output": "../app"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "StudyDesk-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "katex": "0.18.9"
  }
}
